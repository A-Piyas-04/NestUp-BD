\subsection{API Routes}
\label{subsec:api-routes}

\textbf{Directory}: \file{server/routes/}

\textbf{Purpose}: Defines RESTful API endpoints for client-server communication.

\subsubsection{Authentication Routes}
\label{subsubsec:auth-routes}

\textbf{File}: \file{auth.js}

\textbf{Purpose}: Handles user authentication, registration, and session management.

\paragraph{API Endpoints}
\begin{table}[H]
\centering
\small
\begin{tabular}{@{}llll@{}}
\toprule
\textbf{Method} & \textbf{Endpoint} & \textbf{Purpose} & \textbf{Protection} \\
\midrule
POST & /register & User registration with validation & Public \\
POST & /login & User login with JWT token generation & Public \\
POST & /logout & User logout with token clearing & Public \\
GET & /me & Get current user profile & Protected \\
PUT & /profile & Update user profile & Protected \\
\bottomrule
\end{tabular}
\caption{Authentication API Endpoints}
\label{tab:auth-endpoints}
\end{table}

\paragraph{Authentication Flow}
\begin{enumerate}
\item User submits credentials through registration or login form
\item Server validates input data and checks business rules
\item For login: verify password hash and generate JWT token
\item For registration: hash password, create user, and generate token
\item Set HTTP-only cookie with JWT token for secure session management
\item Return user data (excluding sensitive information like password)
\item Implement proper error handling for invalid credentials or duplicate users
\end{enumerate}

