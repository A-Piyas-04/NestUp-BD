\end{table}

\section{Frontend Architecture}
\label{sec:frontend-architecture}

\textbf{Technology Stack}: React 18, React Router, Context API, CSS Modules

\textbf{Architecture Pattern}: Component-based architecture with centralized state management

\subsection{Application Entry Point}
\label{subsec:app-entry}

\textbf{File}: \file{Client/src/main.jsx}

\textbf{Purpose}: React application initialization and root component rendering.

\paragraph{Core Functionality}
\begin{itemize}
\item \textbf{React Initialization}: Imports React 18 and ReactDOM for modern rendering
\item \textbf{Root Rendering}: Renders the main App component using createRoot API
\item \textbf{DOM Mounting}: Mounts application to DOM element with id 'root'
\item \textbf{Strict Mode}: Enables React.StrictMode for development checks
\end{itemize}

\subsection{Main App Component}
\label{subsec:main-app}

\textbf{File}: \file{Client/src/App.jsx}

\textbf{Purpose}: Root component that orchestrates routing and global providers.

\paragraph{Application Structure}
\begin{itemize}
\item \textbf{Context Providers}: Wraps application in AuthProvider for global authentication state
\item \textbf{Routing Setup}: Configures React Router with BrowserRouter for client-side navigation
\item \textbf{Route Definitions}: Defines all application routes and their corresponding components
\item \textbf{Global Styles}: Imports and applies global CSS styles and theme configurations
\item \textbf{Error Boundaries}: Implements error handling for robust user experience
\end{itemize}

\subsection{Context Management}
\label{subsec:context-management}

\textbf{Directory}: \file{Client/src/context/}

\textbf{Purpose}: Centralized state management using React Context API.

\subsubsection{Authentication Context}
\label{subsubsec:auth-context}

\textbf{File}: \file{AuthContext.js}

\textbf{Purpose}: Global state management for user authentication and session handling.

\paragraph{State Properties}
\begin{table}[H]
\centering
\small
\begin{tabular}{@{}lll@{}}
\toprule
\textbf{Property} & \textbf{Type} & \textbf{Description} \\
\midrule
user & Object/null & Current authenticated user object \\
loading & Boolean & Authentication check status \\
isAuthenticated & Boolean & User authentication state \\
error & String/null & Authentication error messages \\
\bottomrule
\end{tabular}
\caption{Authentication Context State}
\label{tab:auth-context-state}
\end{table}

\paragraph{Authentication Methods}
\begin{table}[H]
\centering
\small
\begin{tabular}{@{}lll@{}}
\toprule
\textbf{Method} & \textbf{Parameters} & \textbf{Purpose} \\
\midrule
login() & credentials & Handles user login process \\
logout() & none & Handles user logout and cleanup \\
checkAuth() & none & Verifies current authentication status \\
register() & userData & Handles new user registration \\
updateProfile() & profileData & Updates user profile information \\
\bottomrule
\end{tabular}
\caption{Authentication Context Methods}
\label{tab:auth-context-methods}
\end{table}

\paragraph{Key Features}
\begin{itemize}
\item \textbf{Persistent Sessions}: Maintains authentication state across page refreshes
\item \textbf{Global Access}: Provides authentication methods to all components via useAuth hook
\item \textbf{Loading States}: Manages loading indicators during authentication operations
\item \textbf{Token Management}: Handles JWT token storage and retrieval securely
\item \textbf{Error Handling}: Comprehensive error management for authentication failures
\end{itemize}

